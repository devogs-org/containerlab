delete / system grpc-server eda-mgmt
delete / system grpc-server eda-insecure-mgmt
delete / system grpc-server eda-discovery

# Syslog bootstrap to the showroom collector (connection and license filter only).
# The facility policy (which facilities, at which level) is owned by Ansible:
# showroom-ansible, role "global", inventory/group_vars/srlinux_dc.yml. Until the playbook
# runs, no facility is forwarded. kern (shared host kernel ring buffer) is never a device log.
# - Filter no-license drops the "No valid license" noise of the unlicensed image.
#   composition-operator "and" makes it narrow the facilities (default "or" would widen
#   them and leak kern).
set / system logging filter no-license not-regex "[Ll]icense"
set / system logging filter no-license composition-operator and
set / system logging remote-server 10.16.10.100 transport udp remote-port 514 network-instance mgmt
set / system logging remote-server 10.16.10.100 filter [ no-license ]
